
{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hypemax-testing-2.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://hypemax-testing-2.onrender.com/health"
    },
    {
      "source": "/robots.txt",
      "destination": "https://hypemax-testing-2.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://hypemax-testing-2.onrender.com/sitemap.xml"
    },
    {
      "source": "/products/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/account.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/policies/:path*",
      "destination": "/policies.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/login.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/login.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
