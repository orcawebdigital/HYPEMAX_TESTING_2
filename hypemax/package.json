{
  "name": "hypemax-nutrition-site",
  "version": "2.0.0",
  "private": true,
  "description": "HYPEMAX Nutrition: Node.js app root for Hostinger (serves API + storefront + admin)",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "cd backend && npm install --omit=dev --no-audit --no-fund",
    "start": "node backend/server.js",
    "migrate": "cd backend && npm run migrate",
    "seed": "cd backend && npm run seed",
    "check": "cd backend && npm run check",
    "test": "cd backend && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
